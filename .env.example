# ==============================================================================
# No$otros — Variáveis de Ambiente
# ==============================================================================
# Renomeie ou copie este arquivo para `.env` para execução local com `yarn start`.
# Para builds no EAS (`yarn build:preview`), configure estas variáveis no painel da Expo
# ou via `npx eas env:create` / `eas.json`.
# ==============================================================================

# Supabase (Obrigatório)
# Obtenha em: Supabase Dashboard -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publica-anon-aqui

# Google OAuth Client ID (Opcional - para Backup no Google Drive / Agenda)
# Obtenha no Google Cloud Console com as APIs Drive e Calendar ativadas
EXPO_PUBLIC_GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
