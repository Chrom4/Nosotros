# EAS Ignore - Controls what files are sent to EAS Build
# Unlike .gitignore, we DO NOT ignore .env here so local and EAS builds receive environment variables.

node_modules/
.expo/
dist/
web-build/
expo-env.d.ts

# Native builds
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro & Debug
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*

# OS
.DS_Store
*.pem

# Output packages
*.apk
*.aab

# Supabase & TS
supabase/.temp/
supabase/.branches/
*.tsbuildinfo

# Native prebuilds
/ios
/android
.venv/
